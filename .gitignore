# ==============================================================================
# 🧠 ALETHEIA SNN ENGINE - GITIGNORE
# ==============================================================================

# ------------------------------------------------------------------------------
# 🦀 Rust & Cargo (core_engine, python_bridge)
# ------------------------------------------------------------------------------
# Ignore all build artifacts generated by Cargo/rustc.
/target/

# Backup and temporary files generated by Cargo.
Cargo.lock.log
**/*.rs.bk

# ------------------------------------------------------------------------------
# 🐍 Python (virtual environments, cache, builds)
# ------------------------------------------------------------------------------
# Virtual environments
.venv/
venv/
ENV/
env/
python-venv/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# PyO3 / Maturin / C Extensions build files
*.so
*.pyd
*.dylib
build/
dist/
/python_bridge/dist/
/python_bridge/build/
*.egg-info/
.eggs/

# Testing and linting caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# ------------------------------------------------------------------------------
# ⚡ TypeScript & Vite WebGL (twitch_dashboard)
# ------------------------------------------------------------------------------
# Node dependencies
node_modules/
/twitch_dashboard/node_modules/

# Vite production build artifacts
/twitch_dashboard/dist/
/twitch_dashboard/dist-ssr/

# Vite local environment variables and caches
.env.local
.env.*.local
.vite/
/twitch_dashboard/.vite/

# TypeScript cache
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 💻 IDEs, Editors & System
# ------------------------------------------------------------------------------
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains (IntelliJ, RustRover, PyCharm)
.idea/

# OS-specific files
.DS_Store
Thumbs.db

# General / Temporary / Log files
*.log
tmp/
temp/
